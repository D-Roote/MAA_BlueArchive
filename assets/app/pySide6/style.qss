/* =========================================
   전체 기본 폰트 및 배경 설정
   ========================================= */
QWidget {
    background-color: #F4F7FB;
    color: #334155;
    font-family: "Malgun Gothic", "Segoe UI", sans-serif;
    font-size: 10pt;
}

QMainWindow {
    background-color: #FFFFFF;
}

QScrollArea#scrollSettingWidget {
    border: 1px solid transparent;
}

QFrame#line,
QFrame#line_4 {
    min-height: 1px;
    max-height: 1px;
    border: none;
    background-color: #E2E8F0;
}

QFrame#line_2,
QFrame#line_3 {
    min-width: 1px;
    max-width: 1px;
    border: none;
    background-color: #E2E8F0;
}

/* =========================================
   탭 위젯 (QTabWidget) - 기존 패딩 및 모서리 크기 유지
   ========================================= */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    background-color: #F4F7FB;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    margin-top: -1px;
}

QTabWidget#tabWidget > QStackedWidget,
QWidget#mainTab,
QWidget#settingTab {
    background-color: transparent;
}

QTabBar::tab {
    background-color: #E6EDF5;
    color: #475569;
    padding: 10px 25px;
    border: 1px solid #E2E8F0;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #00AEEF;
    color: #FFFFFF;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #DDE8F5;
}

/* =========================================
   리스트 위젯 (작업 목록, QListWidget)
   ========================================= */
QListWidget {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    margin-bottom: 8px;
    padding: 2px;
    padding-top: 8px;
    outline: none;
}

QListWidget::item {
    background: transparent;
    border: none;
}

QListWidget#taskOptionList::item {
    border-radius: 6px;
}

QFrame#taskListContainer {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
}

QListWidget#taskOptionList {
    border: none;
    border-radius: 0px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin: 0px;
}

QFrame#taskListSeparator {
    border: none;
    background-color: #E2E8F0;
}

QStackedWidget#taskListActionsStack {
    background-color: transparent;
    border: none;
}

QWidget#taskDeletePage {
    background-color: #F8FAFC;
    border: none;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

QWidget#taskListFooter {
    background-color: #00AEEF;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

QWidget#taskListFooter[groupHovered="true"]:!disabled {
    background-color: #009BD6;
}

QWidget#taskListFooter:disabled {
    background-color: #CBD5E0;
}

QFrame#taskDeleteDropZone {
    background-color: transparent;
    border: 1px solid #EF4444;
    border-radius: 4px;
}

QLabel#taskDeleteLabel {
    background-color: transparent;
    color: #EF4444;
    font-size: 8pt;
    font-weight: bold;
}

QListWidget::item:hover {
    background-color: #F8FAFC;
}

QListWidget::item:selected {
    background: transparent;
    border: none;
}

/* =========================================
   버튼 (QPushButton)
   ========================================= */
QPushButton {
    background-color: #00AEEF;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 8px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #009BD6;
}

QPushButton:pressed {
    background-color: #0087BA;
}

QPushButton:disabled {
    background-color: #CBD5E0;
    color: #A0AEC0;
}

QPushButton#taskResetButton {
    padding: 0px;
    background-color: transparent;
    border: none;
    border-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 5px;
}

QPushButton#taskAddButton {
    background-color: transparent;
    border-radius: 0px;
    border-top-left-radius: 0px;
    border-bottom-right-radius: 5px;
    padding-left: 0px;
    padding-right: 34px;
}

QPushButton#taskResetButton:hover,
QPushButton#taskResetButton:pressed,
QPushButton#taskResetButton:disabled,
QPushButton#taskAddButton:hover,
QPushButton#taskAddButton:pressed,
QPushButton#taskAddButton:disabled {
    background-color: transparent;
}

QListWidget#taskPickerPopup {
    margin: 0px;
    padding: 4px;
    border-radius: 6px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QListWidget#taskPickerPopup::item {
    padding: 0px 8px;
    border-radius: 4px;
}

QListWidget#taskPickerPopup::item:hover,
QListWidget#taskPickerPopup::item:selected {
    background-color: #00AEEF;
    color: #FFFFFF;
}

QToolTip {
    background-color: #F8FAFC;
    color: #334155;
    font-size: 7.5pt;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 3px 5px;
}

QPushButton#taskSettingsButton,
QPushButton#endSettingBtn {
    padding: 0px;
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

QPushButton#stopBtn {
    background-color: #FF5A5A;
}
QPushButton#stopBtn:hover {
    background-color: #E04848;
}

/* =========================================
   동적 생성 UI (체크박스, 라디오버튼)
   ========================================= */
QWidget#OptionItemWidget, QWidget > QLabel {
    background-color: transparent;
}

QCheckBox {
    spacing: 6px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: none;
    background-color: transparent;
    subcontrol-origin: margin;
    subcontrol-position: center left;
    image: url("maabaicons:controls/checkbox-unchecked.svg");
}

QCheckBox::indicator:unchecked:hover {
    image: url("maabaicons:controls/checkbox-unchecked-hover.svg");
}

QCheckBox::indicator:checked {
    image: url("maabaicons:controls/checkbox-checked.svg");
}

QCheckBox::indicator:checked:hover {
    image: url("maabaicons:controls/checkbox-checked-hover.svg");
}

QCheckBox::indicator:unchecked:disabled {
    image: url("maabaicons:controls/checkbox-unchecked-disabled.svg");
}

QCheckBox::indicator:checked:disabled {
    image: url("maabaicons:controls/checkbox-checked-disabled.svg");
}

QRadioButton {
    spacing: 8px;
    background-color: transparent;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: none;
    background-color: transparent;
    subcontrol-origin: margin;
    subcontrol-position: center left;
    image: url("maabaicons:controls/radio-unchecked.svg");
}

QRadioButton::indicator:unchecked:hover {
    image: url("maabaicons:controls/radio-unchecked-hover.svg");
}

QRadioButton::indicator:checked {
    image: url("maabaicons:controls/radio-checked.svg");
}

QRadioButton::indicator:checked:hover {
    image: url("maabaicons:controls/radio-checked-hover.svg");
}

QRadioButton::indicator:unchecked:disabled {
    image: url("maabaicons:controls/radio-unchecked-disabled.svg");
}

QRadioButton::indicator:checked:disabled {
    image: url("maabaicons:controls/radio-checked-disabled.svg");
}

QLineEdit#optionInput {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #CBD5E0;
    border-radius: 6px;
    padding: 7px 9px;
    min-height: 20px;
    selection-background-color: #00AEEF;
}

QLineEdit#optionInput:hover,
QLineEdit#optionInput:focus {
    border-color: #00AEEF;
}

QLineEdit#optionInput[inputValid="false"] {
    border-color: #E04848;
}

QLineEdit#optionInput:disabled {
    background-color: #E6EDF5;
    color: #94A3B8;
}

QLabel#optionInputError {
    background-color: transparent;
    color: #E04848;
    font-size: 9pt;
}

QComboBox#optionSelect {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #CBD5E0;
    border-radius: 6px;
    padding: 7px 10px;
    min-height: 20px;
}

QComboBox#optionSelect:hover,
QComboBox#optionSelect:focus {
    border-color: #00AEEF;
}

QComboBox#optionSelect:disabled {
    background-color: #E2E8F0;
    color: #94A3B8;
}

QComboBox#optionSelect::drop-down {
    border: none;
    width: 28px;
}

QComboBox#optionSelect QAbstractItemView {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #CBD5E0;
    selection-background-color: #00AEEF;
    selection-color: #FFFFFF;
    outline: none;
}

/* =========================================
   로그 출력 (QTextEdit)
   ========================================= */
QTextEdit {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    color: #4A5568;
    padding: 8px;
}

QTextEdit#logPrintText {
    padding-right: 1px;
}

QLabel#logTitleLabel {
    color: #334155;
    font-weight: bold;
}

QPushButton#logLatestButton,
QPushButton#logCopyButton,
QPushButton#logClearButton,
QPushButton#logSaveButton {
    min-height: 20px;
    padding: 2px 6px;
    border: 1px solid #CBD5E0;
    border-radius: 5px;
    background-color: #FFFFFF;
    color: #475569;
    font-size: 8pt;
    font-weight: normal;
}

QPushButton#logLatestButton:hover,
QPushButton#logCopyButton:hover,
QPushButton#logClearButton:hover,
QPushButton#logSaveButton:hover {
    background-color: #EAF7FC;
    border-color: #00AEEF;
}

QPushButton#logLatestButton {
    color: #006E94;
    font-weight: bold;
}

/* =========================================
   스크롤바
   ========================================= */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 5px;
    border-radius: 3px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #00AEEF;
    border: 1px solid #00AEEF;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00AEEF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background-color: transparent;
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    border: none;
    background-color: transparent;
    border-radius: 3px;
}

QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    image: none;
    width: 0px;
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 5px;
    border-radius: 3px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #00AEEF;
    border: 1px solid #00AEEF;
    min-width: 20px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #00AEEF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background-color: transparent;
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    border: none;
    background-color: transparent;
    border-radius: 3px;
}

QScrollBar::left-arrow:horizontal, QScrollBar::right-arrow:horizontal {
    image: none;
    width: 0px;
    height: 0px;
}

/* 시작 화면 스크롤바는 5px 슬롯 안에서 숨김/축소/확대한다. */
QScrollBar[contextual="true"]:vertical,
QScrollBar[contextual="true"]::add-page:vertical,
QScrollBar[contextual="true"]::sub-page:vertical {
    background-color: #F8FAFC;
}

QScrollBar[contextual="true"]::handle:vertical {
    background-color: transparent;
    min-height: 20px;
    border: 1px solid transparent;
    border-radius: 3px;
    margin-left: 2px;
    margin-right: 1px;
}

QScrollBar[contextual="true"][contextualVisible="true"]::handle:vertical {
    background-color: #00AEEF;
    border-color: #00AEEF;
}

QScrollBar[contextual="true"][contextualExpanded="true"]::handle:vertical {
    margin-left: 0px;
    margin-right: 1px;
}
