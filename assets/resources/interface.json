{
    "interface_version": 2,
    "name": "MAA_BlueArchive",
    "label": "MAA Blue Archive",
    "version": "0.1.0",
    "title": "MAA Blue Archive",
    "controller": [
        {
            "name": "Win32",
            "type": "Win32",
            "win32": {
                "window_regex": "^Blue Archive$",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithWindowPos",
                "keyboard": "PostMessage"
            },
            "permission_required": false
        }
    ],
    "resource": [
        {
            "name": "DefaultResource",
            "path": [
                "./"
            ],
            "controller": [
                "Win32"
            ]
        }
    ],
    "task": [
        {
            "name": "Login",
            "label": "게임 로그인",
            "default_check": true,
            "entry": "Login_Main"
        },
        {
            "name": "Free_AP",
            "label": "무료 AP 수령",
            "default_check": true,
            "entry": "Reward_Shop_AP_Main"
        },
        {
            "name": "Cafe",
            "label": "카페 보상 수령",
            "default_check": true,
            "entry": "Cafe_Main",
            "option": [
                "Cafe_Bif_Enable",
                "Cafe_Invite_Enable"
            ]
        },
        {
            "name": "Schedule",
            "label": "스케쥴 진행",
            "default_check": true,
            "entry": "Schedule_Main"
        },
        {
            "name": "Bounty",
            "label": "현상수배/학원교류회 소탕",
            "default_check": true,
            "entry": "Bounty_Main",
            "option": [
                "Bounty_Location_Selection",
                "AcaEM_Location_Selection"
            ]
        },
        {
            "name": "Reward",
            "label": "미션 보상 수령",
            "default_check": true,
            "entry": "Reward_Mission_Main"
        }
    ],
    "option": {
        "Cafe_Bif_Enable": {
            "label": "카페 학생 상호작용",
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "label": "활성화",
                    "pipeline_override": {
                        "Cafe_Bif": {
                            "next": [
                                "Cafe_Bif_1"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "비활성화"
                }
            ],
            "default_case": "Yes"
        },
        "Cafe_Invite_Enable": {
            "label": "카페 초대권 사용",
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "label": "활성화",
                    "pipeline_override": {
                        "Cafe_Bif_1": {
                            "next" : [
                                "Cafe_Invite",
                                "Cafe_Interaction_NW"
                            ]
                        },
                        "Cafe_Bif_2": {
                            "next": [
                                "Cafe_Second_Invite",
                                "Cafe_Second_Interaction_NW"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "비활성화"
                }
            ],
            "default_case": "Yes"
        },
        "Bounty_Location_Selection": {
            "label": "현상 수배 의뢰 선택",
            "type": "select",
            "cases": [
                {
                    "name": "Highway",
                    "label": "고가도로"
                },
                {
                    "name": "DesertTrainWay",
                    "label": "사막 기찻길",
                    "pipeline_override": {
                        "Bounty_Select_Location": {
                            "action": {
                                "param": {
                                    "target": [1000, 300, 1, 1]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Classroom",
                    "label": "교실",
                    "pipeline_override": {
                        "Bounty_Select_Location": {
                            "action": {
                                "param": {
                                    "target": [1000, 400, 1, 1]
                                }
                            }
                        }
                    }
                }
            ],
            "default_case": "Highway"
        },
        "AcaEM_Location_Selection": {
            "label": "학원 선택",
            "type": "select",
            "cases": [
                {
                    "name": "Trinity",
                    "label": "트리니티"
                },
                {
                    "name": "Gehenna",
                    "label": "게헨나",
                    "pipeline_override": {
                        "AcaEM_Select_Location": {
                            "action": {
                                "param": {
                                    "target": [1000, 300, 1, 1]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Millennium",
                    "label": "밀레니엄",
                    "pipeline_override": {
                        "AcaEM_Select_Location": {
                            "action": {
                                "param": {
                                    "target": [1000, 400, 1, 1]
                                }
                            }
                        }
                    }
                }
            ],
            "default_case": "Trinity"
        }
    }
}
