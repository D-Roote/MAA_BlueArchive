{
    "name": "MAA_BlueArchive",
    "label": "MAA Blue Archive",
    "version": "0.1.0",
    "title": "MAA Blue Archive",
    "controller": [
        {
            "name": "Win32",
            "type": "Win32",
            "win32": {
                "window_regex": "Blue Archive",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithWindowPos",
                "keyboard": "PostMessage"
            },
            "permission_required": false
        }
    ],
    "resource": [
        {
            "name": "DefaultResource",
            "path": "./",
            "controller": [
                "Win32"
            ]
        }
    ],
    "task": [
        {
            "name": "Login",
            "label": "게임 로그인",
            "entry": "Login_Main"
        },
        {
            "name": "Cafe",
            "label": "카페 보상 수령",
            "entry": "Cafe_Main",
            "option": [
                "Cafe_Bif_Enable"
            ]
        },
        {
            "name": "Schedule",
            "label": "스케쥴 진행",
            "entry": "Schedule_Main"
        },
        {
            "name": "Bounty",
            "label": "현상수배/학원교류회 소탕",
            "entry": "Bounty_Main"
        },
        {
            "name": "Test1",
            "label": "테스트",
            "entry": "Test1",
            "option": [
                "Test1_Focus_Option",
                "Test1_Next_Option"
            ]
        }
    ],
    "option": [
        {
            "name": "Cafe_Bif_Enable",
            "label": "카페 학생 상호작용",
            "type": "switch",
            "cases": [
                {
                    "name": "Bif_Enable",
                    "label": "활성화 (안정성 낮음)",
                    "pipeline_override": {
                        "Cafe_Bif": {
                            "next": [
                                "Cafe_Bif_1"
                            ]
                        }
                    }
                }
            ],
            "default": "Bif_Enable"
        },
        {
            "name": "Test1_Focus_Option",
            "label": "테스트 포커스 설정",
            "type": "select",
            "cases": [
                { "name": "Default", "label": "기본 텍스트" },
                { "name": "Changed Text", "label": "변경된 텍스트",
				"pipeline_override": {
					"Test1": {
						"focus": "Changed Test1"
					}
				}
			 }
            ],
            "default": "Changed Text"
        },
		{
			"name": "Test1_Next_Option",
			"label": "Next 변경",
			"type": "switch",
			"cases": [
				{
					"name": "ON",
					"label": "루프 제거",
					"pipeline_override": {
						"Test3": {
							"next": []
						}
					}
				}
			]
		}
    ]
}